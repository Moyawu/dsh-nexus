<Window x:Class="DshTrayLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DSH Nexus — Консоль и управление"
        Width="980"
        Height="620"
        MinWidth="720"
        MinHeight="440"
        WindowStartupLocation="CenterScreen"
        Background="#11141D"
        Foreground="#E2E8F0">

    <Window.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="#1E2536"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#2E3852"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,6"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A344D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#364363"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="UrlChipButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Background" Value="#152238"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#93C5FD"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="Margin" Value="0,4,6,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="TopBarBorder" Grid.Row="0" Background="#171C28" BorderBrush="#262F45" BorderThickness="0,0,0,1" Padding="14,10">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#F59E0B" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText"
                               Text="Запуск DSH Nexus..."
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               Foreground="#F8FAFC"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="UrlText"
                               Text="  •  http://127.0.0.1:3080"
                               FontSize="12.5"
                               Foreground="#94A3B8"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Открыть Web UI" Style="{StaticResource PrimaryButton}" Click="OpenBrowser_Click"/>
                    <Button Content="Перезапустить" Style="{StaticResource ToolbarButton}" Click="Restart_Click"/>
                    <Button x:Name="ThemeToggleButton" Content="Тема: Dark" Style="{StaticResource ToolbarButton}" Click="ToggleTheme_Click"/>
                    <Button Content="Ярлык на рабочий стол" Style="{StaticResource ToolbarButton}" Click="CreateShortcut_Click"/>
                    <Button Content="Свернуть в трей" Style="{StaticResource ToolbarButton}" Margin="0" Click="HideToTray_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border x:Name="UrlPanel"
                Grid.Row="1"
                Visibility="Collapsed"
                Margin="12,10,12,0"
                Padding="10,7"
                Background="#131926"
                BorderBrush="#24314D"
                BorderThickness="1"
                CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.25" Color="#000000"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock x:Name="UrlPanelHintText"
                           Text="Обнаруженные ссылки (ЛКМ — открыть, ПКМ — копировать):"
                           FontSize="11.5"
                           Foreground="#94A3B8"/>
                <ItemsControl x:Name="UrlsItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}"
                                    Tag="{Binding}"
                                    Style="{StaticResource UrlChipButton}"
                                    Click="UrlButton_Click"
                                    MouseRightButtonUp="UrlButton_RightClick"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border x:Name="SearchBorder"
                Grid.Row="2"
                Margin="12,10,12,0"
                Padding="10,6"
                Background="#171C28"
                BorderBrush="#262F45"
                BorderThickness="1"
                CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.25" Color="#000000"/>
            </Border.Effect>
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="SearchLabelText"
                           DockPanel.Dock="Left"
                           Text="Поиск по логам:"
                           FontSize="12"
                           Foreground="#94A3B8"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <TextBlock x:Name="SearchCountText"
                               Text="Строк: 0"
                               FontSize="12"
                               Foreground="#94A3B8"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <Button Content="✕"
                            Style="{StaticResource ToolbarButton}"
                            Padding="8,3"
                            Margin="0"
                            ToolTip="Сбросить фильтр"
                            Click="ClearSearch_Click"/>
                </StackPanel>
                <TextBox x:Name="SearchTextBox"
                         Background="#0B0E14"
                         Foreground="#E2E8F0"
                         CaretBrush="#E2E8F0"
                         BorderBrush="#2E3852"
                         BorderThickness="1"
                         Padding="8,4"
                         FontSize="12.5"
                         VerticalContentAlignment="Center"
                         TextChanged="SearchTextBox_TextChanged"/>
            </DockPanel>
        </Border>

        <Border x:Name="LogBorder" Grid.Row="3" Margin="12,8,12,8" Background="#0B0E14" BorderBrush="#232B3E" BorderThickness="1" CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.25" Color="#000000"/>
            </Border.Effect>
            <TextBox x:Name="LogTextBox"
                     IsReadOnly="True"
                     IsReadOnlyCaretVisible="False"
                     Background="Transparent"
                     Foreground="#D1D5DB"
                     BorderThickness="0"
                     Padding="12"
                     FontFamily="Cascadia Mono, Consolas, Courier New"
                     FontSize="12.5"
                     TextWrapping="NoWrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"/>
        </Border>

        <Border Grid.Row="4" Padding="14,6,14,12">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="AutoScrollCheckBox"
                              Content="Автопрокрутка"
                              IsChecked="True"
                              Foreground="#CBD5E1"
                              VerticalAlignment="Center"
                              Margin="0,0,16,0"/>
                    <TextBlock x:Name="PathInfoText"
                               Text="Управление профилями: %AppData%\DshNexus\config.json"
                               Foreground="#64748B"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Копировать лог" Style="{StaticResource ToolbarButton}" Click="CopyLogs_Click"/>
                    <Button Content="Очистить" Style="{StaticResource ToolbarButton}" Click="ClearLogs_Click"/>
                    <Button Content="Завершить и выйти"
                            Style="{StaticResource ToolbarButton}"
                            Foreground="#FCA5A5"
                            BorderBrush="#7F1D1D"
                            Margin="0"
                            Click="ExitApp_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>